# 云上牧场 — 环境变量模板
# 复制到项目根 `.env` 后填入真实值。`.env` 已被 .gitignore 排除，禁止提交。

# ===== LLM（阿里云百炼 DashScope，OpenAI 兼容接口）=====
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
# 图像问诊（FR-11）：不填则用内置默认
# LLM_VISION_MODEL=qwen-vl-max-latest
# Embedding（知识库 RAG，与上面共用同一个 Key）
EMBEDDING_MODEL=qwen3.7-text-embedding
DASHSCOPE_API_KEY=

# ===== 数据库 =====
# 与 docker-compose 的 sf-postgres 对齐；换库时同步改这里
DATABASE_URL=postgresql+asyncpg://smartfarm:smartfarm123@127.0.0.1:5432/smart_farm

# ===== 跨进程状态（Redis）=====
# 去重/防抖/合并窗口/心跳/限流/告警广播的共享状态。与 docker-compose 的 sf-redis 对齐
# （宿主端口 16380：6379 被 vmnat 占用，16379 留给智维项目的 mindops_redis）。
# 连不上自动退回进程内存并打 warning，不影响启动——所以部署完必须 curl /api/health
# 确认 state_backend=redis，否则多 worker 下窗口会各算各的而没人发现。
# 后端若也跑在容器里，这里要改成容器网络地址 redis://redis:6379/0，不能用 127.0.0.1。
# 单 worker 部署可留空；多 worker 或多机必须配置。
REDIS_URL=redis://127.0.0.1:16380/0

# ===== 鉴权 =====
# 刻意无默认值：留空时后端在 import 阶段就拒绝启动，不会带着默认密钥跑起来。
# 生成强随机串：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_TTL_SECONDS=86400
LOCK_THRESHOLD=5
LOCK_MINUTES=15

# ----- 未认证入口的按 IP 限流（core/ratelimit.py）-----
# 阈值按部署形态调：一个养殖场常是多人共用一条出口 IP，设备侧常由网关代报多路。
LOGIN_RATE_PER_MINUTE=30
REGISTER_RATE_PER_HOUR=20
INGEST_RATE_PER_MINUTE=600

# API 文档端点（/docs、/openapi.json）。生产不要开——那是一份现成的端点清单
EXPOSE_DOCS=false

# ===== 管理员种子账号（F10 复核链路前提：兽医由管理员创建）=====
# 不填则不建号——刻意不给默认凭据，避免任何环境出现"已知密码的 admin"
ADMIN_SEED_PHONE=
ADMIN_SEED_PASSWORD=

# ===== 气象（高德）=====
# 缺省时 /api/weather 走降级分支（有缓存用缓存，无缓存返回 EX-02）
AMAP_WEATHER_KEY=

# ===== 设备接入 =====
# 离线判定阈值（秒）。07 协议真实口径 300s，演示取 90s 便于观察
OFFLINE_AFTER_SECONDS=90

# MQTT 桥接：true 时后端订阅 EMQX，把设备 data 帧转成 /device/ingest 同一条校验链
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=farm/+/pen/+/+/data

# ===== 向量检索 =====
MILVUS_URI=http://127.0.0.1:19530
# 低于该余弦相似度视为不相关，回退关键词检索
VECTOR_MIN_SCORE=0.30

# ===== CORS =====
# 前端来源白名单（逗号分隔）。换域名/端口只改这里，不改代码
CORS_ORIGINS=http://localhost:3015,http://127.0.0.1:3015

# ===== 原料行情自动采集（可选，默认关）=====
# 单次 30~190s + 约 1.5 万 token，打开后才每日自动跑一次
PRICE_SYNC_ENABLED=false
PRICE_SYNC_HOUR=9
